{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1140px"
		},
		"color": {
			"defaultPalette": false,
			"gradients": [],
			"palette": [
				{
					"slug": "cream",
					"color": "#F7F3E9",
					"name": "Warm cream (background)"
				},
				{
					"slug": "paper",
					"color": "#FFFFFF",
					"name": "Paper (cards)"
				},
				{
					"slug": "sage",
					"color": "#E7ECE3",
					"name": "Sage (soft sections)"
				},
				{
					"slug": "pine",
					"color": "#164733",
					"name": "Deep pine green (primary)"
				},
				{
					"slug": "pine-deep",
					"color": "#0C2E21",
					"name": "Pine deep (hover, footer)"
				},
				{
					"slug": "ink",
					"color": "#1C2A22",
					"name": "Ink (body text)"
				},
				{
					"slug": "ink-soft",
					"color": "#46564C",
					"name": "Soft ink (secondary text)"
				},
				{
					"slug": "gold",
					"color": "#C9A24B",
					"name": "Restrained gold (accent)"
				},
				{
					"slug": "gold-deep",
					"color": "#7A5A1E",
					"name": "Deep gold (small accent text)"
				},
				{
					"slug": "line",
					"color": "#D5DCCF",
					"name": "Hairline (borders)"
				},
				{
					"slug": "error",
					"color": "#8F2B2B",
					"name": "Error"
				},
				{
					"slug": "success",
					"color": "#1F5B3C",
					"name": "Success"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display (local serif stack)",
					"fontFamily": "Georgia, 'Iowan Old Style', 'Times New Roman', 'DejaVu Serif', serif",
					"fontFace": []
				},
				{
					"slug": "body",
					"name": "Body (local system stack)",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'DejaVu Sans', sans-serif",
					"fontFace": []
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "clamp(0.85rem, 0.8rem + 0.2vw, 0.95rem)"
				},
				{
					"slug": "medium",
					"name": "Medium (body)",
					"size": "clamp(1.05rem, 1rem + 0.25vw, 1.15rem)"
				},
				{
					"slug": "large",
					"name": "Large (H3/H4)",
					"size": "clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem)"
				},
				{
					"slug": "x-large",
					"name": "Extra large (H2)",
					"size": "clamp(1.8rem, 1.5rem + 1.4vw, 2.6rem)"
				},
				{
					"slug": "huge",
					"name": "Huge (H1)",
					"size": "clamp(2.3rem, 1.8rem + 2.4vw, 3.6rem)"
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Compact (1rem)", "size": "1rem" },
				{ "slug": "30", "name": "Snug (1.5rem)", "size": "1.5rem" },
				{ "slug": "40", "name": "Comfortable (2.5rem)", "size": "2.5rem" },
				{ "slug": "50", "name": "Roomy (4rem)", "size": "4rem" },
				{ "slug": "60", "name": "Section (6rem)", "size": "6rem" },
				{ "slug": "70", "name": "Grand (8rem)", "size": "8rem" }
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--pine)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--pine-deep)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--pine)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": {
					"radius": "10px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.4rem",
						"bottom": "0.8rem",
						"left": "1.4rem"
					}
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)",
					"textDecoration": "none"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--ink-soft)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--pine)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--pine)"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing page (no page title)",
			"postTypes": [ "page" ]
		}
	]
}
